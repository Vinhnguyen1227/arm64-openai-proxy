# Port for local reverse proxy to listen on
PORT=8080

# Upstream API endpoint host, port, and scheme
# For Hana Gateway / MiMo: api.vilao.ai / 443 / https
# For Xiaomi Token Plan: token-plan-cn.xiaomimimo.com / 443 / https
# For local offline mock testing: host.docker.internal / 9000 / http
UPSTREAM_HOST=api.vilao.ai
UPSTREAM_PORT=443
UPSTREAM_SCHEME=https

# Official upstream API key (Bearer token injected by proxy)
MIMO_API_KEY=sk-your-upstream-key-here

# Virtual API keys allocated to local clients/tenants
USER_A_KEY=sk-userA-vkey-001
USER_B_KEY=sk-userB-vkey-002

# Target model name
MODEL_NAME=hana/mimo-v2.5
